# ============================================================
# Variables de Entorno de Producción / Desarrollo — EventPass
# ============================================================

# Entorno de ejecución: 'production' o 'development'
NODE_ENV=production

# Puerto y host del servidor Express
PORT=4000
HOST=0.0.0.0

# Conexión a MongoDB (MongoDB Atlas o local)
# Formato: mongodb+srv://<usuario>:<password>@cluster0.rwjtzad.mongodb.net/eventpass?retryWrites=true&w=majority
MONGODB_URI=

# Secreto criptográfico para firma y verificación de JSON Web Tokens (JWT)
# Generar una cadena larga y aleatoria (ej. con openssl rand -base64 32)
JWT_SECRET=

# Tiempo de expiración de las sesiones JWT (ej. 7d, 24h)
JWT_EXPIRES_IN=7d

# Orígenes permitidos para CORS (separados por coma, sin barras finales)
# En desarrollo: http://localhost:5500,http://127.0.0.1:5500
# En producción: https://tu-frontend.vercel.app,https://tu-frontend.netlify.app
# En modo monolito o pruebas abiertas: *
CORS_ORIGIN=

# Servir frontend estático directamente desde Express (Modo Monolito Fullstack)
# true: sirve eventpass-frontend-v2 en la raíz (recomendado para desplegar todo en Render con 1 solo servicio)
# false: backend opera exclusivamente como API REST desacoplada
SERVE_FRONTEND=true

# Seguridad: Límite de intentos de login por IP cada 15 minutos
LOGIN_LIMIT=10

# Seguridad: Código de invitación requerido para registrar administradores (opcional)
# Dejar vacío si deseas que cualquier persona pueda registrarse como admin
ADMIN_INVITE_CODE=

# Seguridad Anti-Bot: Clave secreta de Cloudflare Turnstile
# Pruebas (siempre pasa): 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Autenticación Google: Client ID de Google Cloud Console
# Formato: 1234567890-abcdefghijklmn.apps.googleusercontent.com
GOOGLE_CLIENT_ID=
